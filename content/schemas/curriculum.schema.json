{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurriculumTree",
  "type": "object",
  "required": [
    "version",
    "name",
    "nodes"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    }
  },
  "$defs": {
    "Node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "school",
            "subject",
            "textbook",
            "chapter",
            "section",
            "lesson",
            "knowledgePoint"
          ]
        },
        "subject": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "knowledgePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}